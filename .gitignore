# ---- 构建产物 ----
/dist/
/src/bridge/build/
build/
*.apk
*.ipa
*.idsig

# ---- 第三方 / 不入库 ----
# apktool 是 24M 的第三方 jar，缺了从官方或本机其他目录拷一份进来
/patch/apktool.jar

# ---- 原厂素材：不入库 ----
# 原厂安装包（自行从合法渠道取得）
/apk/
# 从原包导出的产物
/dex/
/dump_*/
# 原厂包里提取的配置包（--assets-config 的输入，本地自备）
/patch/navi_configs/

# ---- 本地文档与资料：只留本地，不上传 ----
/docs/
/analysis/
/archive/
/README.local.md

# ---- 本地配置 ----
# 本机路径覆盖（JDK / build-tools / android.jar / ASCII 构建目录）
scripts/config.local.sh
local.properties
local.env

# ---- 预览：只留假数据服务，调试脚本与截图随时重生成 ----
/preview/*
!/preview/mock.js
/ui_preview/

# ---- Gradle / IDE / 系统 ----
.gradle/
.idea/
*.iml
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log

# ---- 本地隔离待删 ----
/_trash/

# ---- 构建时从 web/pages 拷进来的副本（单一真相在 web/pages）----
music/cloudmusic-car/lunastub/src/main/assets/remote.html
music/cloudmusic-car/lunastub/src/main/assets/dvr.html
music/cloudmusic-car/app/src/main/assets/remote.html

# ---- iOS 生成物 ----
phone/ios/out/
phone/ios/build/
phone/ios/*.xcodeproj/
