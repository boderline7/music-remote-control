# ---- 构建产物 ----
/src/bridge/build/
build/
*.apk
*.ipa
*.idsig
# dist 只放行成品包
/dist/*
!/dist/*.apk
!/dist/*.ipa

# ---- 第三方 / 不入库 ----
# apktool 是 24M 的第三方 jar，缺了从官方或本机其他目录拷一份进来
/patch/apktool.jar

# ---- 原厂素材：不入库 ----
# 原厂安装包（自行从合法渠道取得）
/apk/
# 脱壳产物与环境已入库
# 原厂包里提取的配置包（--assets-config 的输入，已入库）

# ---- 本地文档与资料 ----
# docs/ 入库（自写文档）；analysis/ 与 archive/ 只留本地
/analysis/
/archive/
/README.local.md

# ---- 本地配置 ----
# 本机路径覆盖（JDK / build-tools / android.jar / ASCII 构建目录）
scripts/config.local.sh
local.properties
local.env

# ---- 预览：只留假数据服务，调试脚本与截图随时重生成 ----
/preview/*
!/preview/mock.js
/ui_preview/

# ---- Gradle / IDE / 系统 ----
.gradle/
.idea/
*.iml
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log

# ---- 本地隔离待删 ----
/_trash/

# ---- 构建时从 web/pages 拷进来的副本（单一真相在 web/pages）----
music/cloudmusic-car/app/src/main/assets/remote.html

# ---- iOS 生成物 ----
phone/ios/out/
phone/ios/build/
phone/ios/*.xcodeproj/
