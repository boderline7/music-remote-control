<?xml version="1.0" encoding="utf-8"?>
<!--
  与 iOS 端 AppIcon.png 完全同款：深色底 + 正红圆 + 白色播放三角。
  自适应图标的 108dp 画布只有中心约 72dp 会被 launcher 显示（外侧 18dp 是视差/裁切区），
  所以不能把 iOS 的 58.4% 占比直接套到 108dp 上，否则红圆会被放大到几乎顶满图标。
  换算：iOS 圆半径 299/1024 -> 相对可见区半径 72 × 0.292 ≈ 21dp。
  三角按同一比例缩放：左边 x=422、顶点 x=662、上下 y=372/652
    -> 相对中心 -6.3 / +10.5 / ±9.8 -> x=47.7 / 64.5、y=44.2 / 63.8。
  深色底由 ic_launcher_background 提供，这里只画前景，其余透明。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 正红圆 -->
    <path
        android:fillColor="#FA2D48"
        android:pathData="M54,33 a21,21 0 1,0 0,42 a21,21 0 1,0 0,-42 z" />

    <!-- 白色播放三角 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47.7,44.2 L64.5,54 L47.7,63.8 Z" />
</vector>
